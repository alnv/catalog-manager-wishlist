{
  "name": "alnv/catalog-manager-wishlist",
  "description": "Extension for Catalog Manager. This Extension allows you to create a wishlist.",
  "keywords": [ "contao", "catalog", "manager", "wishlist", "extension" ],
  "type": "contao-module",
  "homepage": "https://catalog-manager.org",
  "license": "proprietary",
  "authors": [
    {
      "name": "Alexander Naumov",
      "homepage": "https://alexandernaumov.de",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "mail@alexandernaumov.de",
    "issues": "https://github.com/alnv/catalog-manager-wishlist/issues",
    "wiki": "https://catalog-manager.org/dokumentation/catalog-manager-wunschliste.html"
  },
  "require": {
    "php":">=8.0",
    "contao/core-bundle": "~4.13 || ~5.3",
    "alnv/catalog-manager":"^2.0"
  },
  "autoload": {
    "psr-4": {
      "Alnv\\CatalogManagerWishlistBundle\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "contao-manager-plugin": "Alnv\\CatalogManagerWishlistBundle\\ContaoManager\\Plugin"
  }
}